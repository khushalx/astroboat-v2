# Optional: only set these after creating the corresponding external accounts.
# These are metadata tokens, not API secrets.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=

# NASA API key (optional). Used for the APOD API fallback and the NeoWs asteroid
# fallback; without it the shared, heavily rate-limited DEMO_KEY is used.
NASA_API_KEY=your_nasa_api_key_here

# Durable content history (recommended in production). Keeps old brief URLs and
# gallery share links working and powers last-known-good fallbacks. Vercel's
# Marketplace "Upstash for Redis" integration sets these automatically.
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted as alternatives.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: enables GET /api/diagnostics/content in production (24+ characters,
# sent as "Authorization: Bearer <token>").
CONTENT_DIAGNOSTICS_TOKEN=

# Groq API key for AI assistant features
GROQ_API_KEY=your_groq_api_key_here
# Optional model override (default: openai/gpt-oss-120b). Include the provider prefix.
GROQ_MODEL=openai/gpt-oss-120b
