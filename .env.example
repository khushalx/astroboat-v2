# Optional: only set these after creating the corresponding external accounts.
# These are metadata tokens, not API secrets.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=

# NASA API key for APOD and planetary endpoints (optional - DEMO_KEY is used as fallback)
NASA_API_KEY=your_nasa_api_key_here

# Groq API key for AI assistant features
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# GPT-OSS alternative (include the provider prefix): openai/gpt-oss-120b
